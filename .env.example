# ASSO Platform Environment Configuration
# LOCAL DEVELOPMENT

# Server & Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asso_dev
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/asso_dev

# Supabase Auth / Local JWT Simulation
SUPABASE_URL=https://localhost.supabase.co
SUPABASE_ANON_KEY=local-dev-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-key-placeholder
JWT_SECRET=super-secret-local-dev-jwt-key-minimum-32-chars-long

# Storage (S3 / Supabase Storage)
STORAGE_BUCKET=asso-media-dev
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=http://localhost:9000

# Realtime / SSE
REALTIME_HEARTBEAT_INTERVAL_MS=15000

# Idempotency
IDEMPOTENCY_EXPIRATION_HOURS=24
